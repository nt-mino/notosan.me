{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noto",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-17",
  "routes": [{ "pattern": "notosan.me", "custom_domain": true }],
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  "observability": {
    "enabled": true,
  },
}
