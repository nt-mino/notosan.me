---
import flarelyMark from "@/assets/flarely-mark.svg";
import { flarely } from "@/data/flarely";
import { site } from "@/data/site";
import { feedSources } from "@/lib/feeds";

const links = [
	{
		label: "LinkedIn",
		href: site.linkedin,
		color: "#0a66c2",
		path: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
	},
	{
		label: "Zenn",
		href: feedSources.zenn,
		color: "#3ea8ff",
		path: "M.264 23.771h4.984c.264 0 .498-.147.645-.352L19.614.874c.176-.293-.029-.645-.381-.645h-4.72c-.235 0-.44.117-.557.323L.03 23.361c-.088.176.029.41.234.41zM17.445 23.419l6.479-10.408c.205-.323-.029-.733-.41-.733h-4.691c-.176 0-.352.088-.44.235l-6.655 10.643c-.176.264.029.616.352.616h4.779c.234-.001.468-.118.586-.353z",
	},
].filter((link) => link.href);
---

<ul class="sns">
  {links.map((link) => (
    <li>
      <a href={link.href} rel="noopener" target="_blank" aria-label={link.label}>
        <svg
          viewBox="0 0 24 24"
          width="20"
          height="20"
          fill={link.color}
          aria-hidden="true"
        >
          <path d={link.path} />
        </svg>
      </a>
    </li>
  ))}
  <li>
    <a href={flarely.url} rel="noopener" target="_blank" aria-label={flarely.name}>
      <img src={flarelyMark.src} alt="" width="9" height="22" />
    </a>
  </li>
</ul>
