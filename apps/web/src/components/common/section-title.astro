---
import flamey from "@/assets/flamey.svg";

export interface Props {
	id: string;
	en: string;
	lead?: string;
	as?: "h1" | "h2";
}

const { id, en, lead, as: Tag = "h2" } = Astro.props;
---

<Tag class:list={["eyebrow", { page: Tag === "h1" }]} id={id} translate="no">
  <img src={flamey.src} alt="" width="32" height="40" />
  {en}
</Tag>
{lead && <p class="section-lead">{lead}</p>}
