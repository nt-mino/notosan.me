---
import { Image } from "astro:assets";
import type { Project } from "@/lib/microcms/types/project";

export interface Props {
	projects: Project[];
}

const { projects } = Astro.props;
---

<div class="prjs">
  {projects.map((project) => (
    <a class="prj" href={`/projects/${project.id}`}>
      {project.icon && (
        <Image class="icon" src={project.icon.url} alt="" width={128} height={128} />
      )}
      <div>
        <span class="n" translate="no">{project.name}</span>
        <span class="t">{project.description}</span>
      </div>
    </a>
  ))}
</div>
