---
import type { Project } from '@/data/projects'

export interface Props {
  projects: Project[]
}

const { projects } = Astro.props
---

<div class="prjs">
  {projects.map((project) => (
    <a class="prj" href={`/projects/${project.slug}`}>
      <div class="icon" aria-hidden="true" translate="no">
        {project.name.charAt(0).toUpperCase()}
      </div>
      <div>
        <span class="n" translate="no">{project.name}</span>
        <span class="t">{project.tagline}</span>
      </div>
      <span class="st">{project.status}</span>
    </a>
  ))}
</div>
