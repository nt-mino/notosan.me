---
export interface Props {
  isTop?: boolean
  tagline?: string
}

const { isTop = false, tagline } = Astro.props
const prefix = isTop ? '' : '/'
const links = [
  { href: `${prefix}#career`, label: '経歴' },
  { href: `${prefix}#projects`, label: '個人開発' },
  { href: `${prefix}#writing`, label: '記事' },
  { href: `${prefix}#company`, label: '運営会社' },
  { href: '/contact', label: 'お問い合わせ' },
]
---

<div class:list={['band', { sm: !tagline }]}>
  <div class="col">
    <header class="pad">
      <a class="logo" href="/">
        <img src="/logo.png" alt="noto" width="69" height="32" />
      </a>
      <nav aria-label="メイン">
        {links.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    </header>
    {tagline && <p class="tag pad">{tagline}</p>}
  </div>
</div>
