---
import { Image } from 'astro:assets'
import { site } from '@/data/site'
import { getArticles } from '@/lib/microcms/api/articles'
import { formatDate } from '@/utils/format'

const ARTICLE_COUNT = 8

const { contents } = await getArticles({ limit: ARTICLE_COUNT })
---

<section id="writing" class="pad" aria-labelledby="h-writing">
  <h2 id="h-writing">記事</h2>
  <div class="arts">
    {contents.map((article) => (
      <a class="art" href={article.zennUrl} rel="noopener" target="_blank">
        {article.thumbnail ? (
          <Image
            src={article.thumbnail.url}
            alt=""
            width={600}
            height={315}
            loading="lazy"
          />
        ) : (
          <span class="art-blank" aria-hidden="true" />
        )}
        <span class="d">
          {[formatDate(article.date), ...article.category].join('・')}
        </span>
        <span class="tt">{article.title}</span>
      </a>
    ))}
  </div>
  <p class="more">
    <a href={site.writingMore} rel="noopener" target="_blank">
      Zenn でほかの記事を読む
    </a>
  </p>
</section>
