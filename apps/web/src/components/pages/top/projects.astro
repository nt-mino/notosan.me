---
import ProjectList from "@/components/common/project-list.astro";
import SectionTitle from "@/components/common/section-title.astro";
import { getProjects } from "@/lib/microcms/api/projects";

const projects = await getProjects();
---

<section id="projects" class="pad" aria-labelledby="h-projects">
  <SectionTitle id="h-projects" en="Projects"
    lead="自分で企画して作っているアプリ"
  />
  <ProjectList projects={projects} />
</section>
