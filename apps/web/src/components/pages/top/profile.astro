---
import { flarely } from '@/data/flarely'
import { site } from '@/data/site'
---

<section class="profile pad" aria-label="プロフィール">
  <div class="who">
    <div class="photo">写真</div>
    <div class="txt">
      <h1 translate="no">{site.nameEn}</h1>
      <p class="kana">{site.name}・{site.role}</p>
    </div>
  </div>
  <p class="info">
    <span>{site.location}</span>
    <i aria-hidden="true">・</i>
    <a href="#company" translate="no">{flarely.name}</a>
    <span>{flarely.position}</span>
    <i aria-hidden="true">・</i>
    <a href={site.linkedin} rel="noopener" target="_blank">LinkedIn</a>
  </p>
</section>
